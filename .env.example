# Application
APP_NAME="Meeting Assistant"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (MySQL)
DATABASE_URL=mysql+aiomysql://root:Root%401234@127.0.0.1:3306/meeting_assistant

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=meeting_transcripts

# OpenRouter (LLM)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SUMMARY_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_TASK_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.1-8b-instruct

# Whisper (OpenAI Cloud Transcription)
OPENAI_API_KEY=your-openai-api-key-here

# File Storage
STORAGE_PATH=./storage/recordings

# Email (Mailtrap)
MAILTRAP_API_TOKEN=your-mailtrap-api-token
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME="Meeting Assistant"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
